#!/usr/bin/env python3
"""Apply only validated static-site routes generated by the TMP Server host agent."""
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

WEBSITES_ROOT = "/home/triumphant/.local/share/tmpserver/websites"
PENDING_SITES = os.path.join(WEBSITES_ROOT, ".tmpserver-caddy-sites.json")
CADDYFILE = "/etc/caddy/Caddyfile"
MARKER = "# TMP_SERVER_WEBSITES"
SLUG_RE = re.compile(r"^[a-z0-9-]{1,48}$")
DOMAIN_RE = re.compile(r"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$", re.IGNORECASE)


def checked_routes():
    with open(PENDING_SITES, "r", encoding="utf-8") as source:
        sites = json.load(source)
    if not isinstance(sites, list) or len(sites) > 1000:
        raise ValueError("The pending website index must be a list of at most 1000 entries.")
    blocks = []
    root_real = os.path.realpath(WEBSITES_ROOT)
    for site in sites:
        if not isinstance(site, dict) or site.get("kind", "hosted") != "hosted" or site.get("active") is not True:
            continue
        slug = site.get("slug", "")
        domain = site.get("domain", "")
        if not isinstance(slug, str) or not SLUG_RE.fullmatch(slug):
            raise ValueError("A hosted website has an unsafe slug.")
        if not isinstance(domain, str) or not DOMAIN_RE.fullmatch(domain):
            raise ValueError("A hosted website has an invalid domain.")
        site_parent = os.path.join(WEBSITES_ROOT, slug)
        public_path = os.path.join(site_parent, "public")
        if os.path.islink(site_parent) or os.path.islink(public_path):
            raise ValueError("A hosted website may not use a symbolic-link directory.")
        site_root = os.path.realpath(public_path)
        try:
            if os.path.commonpath((root_real, site_root)) != root_real:
                raise ValueError("A hosted website root escapes the configured website directory.")
        except ValueError as error:
            raise ValueError("A hosted website root escapes the configured website directory.") from error
        if not os.path.isdir(site_root):
            raise ValueError(f"The public directory for {domain} does not exist.")
        os.chmod(os.path.dirname(WEBSITES_ROOT), 0o711)
        cloud_root = os.path.join(os.path.dirname(WEBSITES_ROOT), "cloud")
        if os.path.isdir(cloud_root):
            os.chmod(cloud_root, 0o700)
        os.chmod(WEBSITES_ROOT, 0o755)
        os.chmod(site_parent, 0o755)
        for current, directories, filenames in os.walk(site_root, followlinks=False):
            for name in directories:
                path = os.path.join(current, name)
                if os.path.islink(path):
                    raise ValueError("Static website content may not contain symbolic links.")
                os.chmod(path, 0o755)
            for name in filenames:
                path = os.path.join(current, name)
                if os.path.islink(path):
                    raise ValueError("Static website content may not contain symbolic links.")
                os.chmod(path, 0o644)
            os.chmod(current, 0o755)
        blocks.append(f"{domain} {{\n    root * {site_root}\n    encode gzip\n    file_server\n}}")
    return blocks


def write_candidate(content, original_stat):
    directory = os.path.dirname(CADDYFILE)
    fd, path = tempfile.mkstemp(prefix=".tmpserver-caddy-", dir=directory, text=True)
    try:
        os.fchown(fd, original_stat.st_uid, original_stat.st_gid)
        os.fchmod(fd, stat.S_IMODE(original_stat.st_mode))
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        return path
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.remove(path)
        except OSError:
            pass
        raise


def main():
    try:
        with open(CADDYFILE, "r", encoding="utf-8") as source:
            original = source.read()
        original_stat = os.stat(CADDYFILE)
        base = original.split("\n" + MARKER + "\n", 1)[0].rstrip()
        blocks = checked_routes()
        content = base + "\n\n" + MARKER + "\n" + ("\n\n".join(blocks) if blocks else "") + "\n"
        candidate = write_candidate(content, original_stat)
        try:
            validated = subprocess.run(["caddy", "validate", "--config", candidate, "--adapter", "caddyfile"], capture_output=True, text=True, timeout=30)
            if validated.returncode != 0:
                raise RuntimeError((validated.stderr or validated.stdout or "Caddy validation failed.")[-1200:])
            backup_path = CADDYFILE + ".tmpserver.bak"
            shutil.copy2(CADDYFILE, backup_path)
            os.replace(candidate, CADDYFILE)
            candidate = ""
            reloaded = subprocess.run(["systemctl", "reload", "caddy"], capture_output=True, text=True, timeout=45)
            if reloaded.returncode != 0:
                fd, restore = tempfile.mkstemp(prefix=".tmpserver-caddy-rollback-", dir=os.path.dirname(CADDYFILE), text=True)
                with os.fdopen(fd, "w", encoding="utf-8") as output:
                    output.write(original)
                    output.flush()
                    os.fsync(output.fileno())
                os.chown(restore, original_stat.st_uid, original_stat.st_gid)
                os.chmod(restore, stat.S_IMODE(original_stat.st_mode))
                os.replace(restore, CADDYFILE)
                subprocess.run(["systemctl", "reload", "caddy"], capture_output=True, text=True, timeout=45)
                raise RuntimeError((reloaded.stderr or reloaded.stdout or "Caddy reload failed; the prior configuration was restored.")[-1200:])
        finally:
            if candidate and os.path.exists(candidate):
                os.remove(candidate)
        return 0
    except Exception as error:
        print(f"tmpserver-caddy-sync: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
