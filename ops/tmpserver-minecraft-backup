#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

: "${TMP_SERVER_COMPOSE_FILE:?Set TMP_SERVER_COMPOSE_FILE in /etc/tmpserver-host-agent.env}"
: "${TMP_SERVER_COMPOSE_PROJECT:?Set TMP_SERVER_COMPOSE_PROJECT in /etc/tmpserver-host-agent.env}"
: "${TMP_SERVER_MINECRAFT_SERVICE:?Set TMP_SERVER_MINECRAFT_SERVICE in /etc/tmpserver-host-agent.env}"

expand_home() {
  local value="$1"
  case "$value" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${value#\~/}" ;;
    *) printf '%s' "$value" ;;
  esac
}

data_root="$(expand_home "${TMP_AGENT_DATA_ROOT:-$HOME/.local/share/tmpserver}")"
cloud_root="$(expand_home "${TMP_AGENT_CLOUD_ROOT:-$data_root/cloud}")"
if [[ "$cloud_root" != /* ]]; then
  cloud_root="$PWD/$cloud_root"
fi
mkdir -p -- "$cloud_root/.tmpserver-uploads"
command -v flock >/dev/null 2>&1 || { echo "The util-linux flock command is required for safe backup locking." >&2; exit 1; }
exec 9>"$cloud_root/.tmpserver-uploads/minecraft-backup.lock"
if ! flock -n 9; then
  echo "Another Minecraft backup is already running." >&2
  exit 1
fi

case "${TMP_COMPOSE_COMMAND:-docker compose}" in
  "docker compose") compose_bin=(docker compose) ;;
  docker-compose) compose_bin=(docker-compose) ;;
  *) echo "TMP_COMPOSE_COMMAND must be 'docker compose' or 'docker-compose'." >&2; exit 2 ;;
esac
compose_args=()
if [[ -n "$TMP_SERVER_COMPOSE_PROJECT" ]]; then
  compose_args+=(-p "$TMP_SERVER_COMPOSE_PROJECT")
fi
compose_args+=(-f "$TMP_SERVER_COMPOSE_FILE")
compose() {
  "${compose_bin[@]}" "${compose_args[@]}" "$@"
}
rcon() {
  compose exec -T "$TMP_SERVER_MINECRAFT_SERVICE" rcon-cli "$1"
}

backup_file="$cloud_root/minecraft-latest.tar.gz"
temp_file=""
saving_disabled=0
cleanup() {
  local result=$?
  trap - EXIT
  if (( saving_disabled )); then
    rcon "save-on" >/dev/null 2>&1 || true
  fi
  if [[ -n "$temp_file" && -e "$temp_file" ]]; then
    rm -f -- "$temp_file"
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

temp_file="$(mktemp "$cloud_root/.tmpserver-uploads/minecraft-backup.XXXXXXXX")"
saving_disabled=1
rcon "save-off" >/dev/null
rcon "save-all flush" >/dev/null

# Keep writes paused only while the world and server data are streamed to the
# archive. Logs are excluded because they continue changing while Paper runs.
compose exec -T "$TMP_SERVER_MINECRAFT_SERVICE" sh -c 'tar -C /data --exclude=./logs --exclude=./crash-reports -czf - .' > "$temp_file"
rcon "save-on" >/dev/null
saving_disabled=0

gzip -t -- "$temp_file"
mv -f -- "$temp_file" "$backup_file"
temp_file=""
printf 'Minecraft backup saved: %s\n' "$backup_file"
