# Copy to /etc/tmpserver-host-agent.env and replace every placeholder.
# Never commit real values here. The anon key is browser-safe; never use a service-role key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_BROWSER_SAFE_ANON_KEY
OWNER_EMAIL=owner@example.com

# Exact web dashboard origin(s), comma-separated; include scheme, no path or trailing slash.
ALLOWED_ORIGINS=https://dashboard.example.com

# Match the Linux host's actual Compose project and service names.
TMP_SERVER_COMPOSE_FILE=/home/YOUR_LINUX_USER/server-stack/docker-compose.yml
TMP_SERVER_COMPOSE_PROJECT=minecraft-server
TMP_SERVER_MINECRAFT_SERVICE=mc_crossplay_server
TMP_COMPOSE_COMMAND=docker-compose
PUBLIC_HOSTNAME=mc.example.com
TMP_AGENT_CADDY_SYNC_SCRIPT=/usr/local/bin/tmpserver-caddy-sync

# The agent binds to 127.0.0.1 only. Do not publish this port in Docker or the router.
TMP_AGENT_PORT=8787
TMP_AGENT_DATA_ROOT=/home/YOUR_LINUX_USER/.local/share/tmpserver

# Install ops/tmpserver-minecraft-backup at this path before starting backup-dependent actions.
TMP_SERVER_BACKUP_SCRIPT=/usr/local/bin/tmpserver-minecraft-backup
